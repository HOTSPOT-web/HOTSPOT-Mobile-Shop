rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CHANGE THIS to the email you use to log in to admin.html
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "hotspot.mobileshop@gmail.com";
    }

    // Everyone can see products. Only you can change them.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Running order number. Customers may only add 1 to it. You (admin) can set it to anything.
    match /counters/orders {
      allow read: if true;
      allow create: if isAdmin() || (request.resource.data.keys().hasOnly(['n'])
                       && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 1);
      allow update: if isAdmin() || (request.resource.data.keys().hasOnly(['n'])
                       && request.resource.data.n == resource.data.n + 1);
      allow delete: if isAdmin();
    }

    // Everyone can place an order. Only you can read, change or delete orders.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['ref','name','phone','addr','notes','pay','total','items','status','createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
                    && request.resource.data.addr is string && request.resource.data.addr.size() <= 400
                    && request.resource.data.notes is string && request.resource.data.notes.size() <= 600;
      allow read, update, delete: if isAdmin();
    }
  }
}
